{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python311", "gcc"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd backend && uvicorn chat_api:app --host 0.0.0.0 --port $PORT"
  }
}
